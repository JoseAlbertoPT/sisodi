generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model accion {
  id              Int               @id @default(autoincrement())
  nombre          String            @db.VarChar(100)
  descripcion     String?
  rol_menu_accion rol_menu_accion[]
}

model adjunto {
  id             Int       @id @default(autoincrement())
  solicitud_id   Int
  nombre_archivo String    @db.VarChar(255)
  ruta           String
  tipo           String?   @db.VarChar(100)
  fecha_subida   DateTime? @default(now()) @db.Timestamp(6)
  solicitud      solicitud @relation(fields: [solicitud_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model area {
  id          Int       @id @default(autoincrement())
  nombre      String    @db.VarChar(150)
  descripcion String?
  activo      Boolean?  @default(true)
  usuario     usuario[]
}

model checklist {
  id                Int                 @id @default(autoincrement())
  nombre            String              @db.VarChar(150)
  etapa             String?             @db.VarChar(10)
  checklist_detalle checklist_detalle[]
}

model checklist_detalle {
  id           Int       @id @default(autoincrement())
  checklist_id Int
  solicitud_id Int
  descripcion  String
  cumplido     Boolean?  @default(false)
  checklist    checklist @relation(fields: [checklist_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  solicitud    solicitud @relation(fields: [solicitud_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model consecutivo_folio {
  id          Int     @id @default(autoincrement())
  tipo        String? @db.VarChar(50)
  mes         Int?
  anio        Int?
  consecutivo Int?    @default(1)

  @@unique([tipo, mes, anio])
}

model dictamen {
  id            Int       @id @default(autoincrement())
  solicitud_id  Int       @unique
  folio         String    @db.VarChar(50)
  fecha_emision DateTime  @db.Timestamp(6)
  tipo_firma    String?   @db.VarChar(20)
  archivo_pdf   String?
  solicitud     solicitud @relation(fields: [solicitud_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model firma_proceso {
  id               Int              @id @default(autoincrement())
  solicitud_id     Int              @unique
  tipo             String           @db.VarChar(20)
  proceso_id       String?          @db.VarChar(100)
  uuid             String?          @unique @db.VarChar(100)
  uuid_ws_firma    String?          @db.VarChar(100)
  datos_ws_firma   Json?
  acceso_token     String?          @db.VarChar(64)
  total_firmantes  Int?
  firmados         Int              @default(0)
  archivo_firmado  String?          @db.VarChar(500)
  estado           String           @default("iniciado") @db.VarChar(20)
  creado_por_id    String           @db.Uuid
  fecha_creacion   DateTime         @default(now()) @db.Timestamp(6)
  fecha_completado DateTime?        @db.Timestamp(6)
  accedido_en      DateTime?        @db.Timestamp(6)
  expira_en        DateTime?        @db.Timestamp(6)
  session_id       String?          @db.VarChar(64)
  solicitud        solicitud        @relation(fields: [solicitud_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuario          usuario          @relation(fields: [creado_por_id], references: [id], onUpdate: NoAction)
  firmantes        firma_firmante[]

  @@index([solicitud_id], map: "idx_firma_proceso_solicitud")
}

model firma_firmante {
  id               Int           @id @default(autoincrement())
  firma_proceso_id Int
  orden            Int
  rol              String        @db.VarChar(30)
  cargo            String        @db.VarChar(300)
  tipo             String        @db.VarChar(20)
  bandeja          String?       @db.VarChar(20)
  usuario_id       String?       @db.Uuid
  nombre           String?       @db.VarChar(200)
  rfc              String?       @db.VarChar(20)
  correo           String?       @db.VarChar(200)
  cargo_firmante   String?       @db.VarChar(300)
  firmado          Boolean       @default(false)
  verificado       Boolean       @default(false)
  fecha_firma      DateTime?     @db.Timestamp(6)
  acceso_token     String?       @unique @db.VarChar(64)
  accedido_en      DateTime?     @db.Timestamp(6)
  expira_en        DateTime?     @db.Timestamp(6)
  session_id       String?       @db.VarChar(64)
  sello_digital         String?   @db.Text
  estampado_tiempo      String?   @db.VarChar(50)
  sello_estampado_tiempo String? @db.Text
  no_certificado_gem    String?   @db.VarChar(50)
  rfc_gem               String?   @db.VarChar(20)
  url_validacion        String?   @db.VarChar(500)
  url_validacion_corta  String?   @db.VarChar(200)
  uuid_firma            String?   @db.VarChar(100)
  firma_proceso    firma_proceso @relation(fields: [firma_proceso_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuario          usuario?      @relation(fields: [usuario_id], references: [id], onUpdate: NoAction)

  @@index([firma_proceso_id], map: "idx_firma_firmante_proceso")
}

model estado {
  id                                                                 Int                   @id @default(autoincrement())
  nombre                                                             String                @unique @db.VarChar(100)
  descripcion                                                        String?
  historial_solicitud_historial_solicitud_estado_anterior_idToestado historial_solicitud[] @relation("historial_solicitud_estado_anterior_idToestado")
  historial_solicitud_historial_solicitud_estado_nuevo_idToestado    historial_solicitud[] @relation("historial_solicitud_estado_nuevo_idToestado")
  solicitud                                                          solicitud[]
}

model historial_solicitud {
  id                                                    Int       @id @default(autoincrement())
  solicitud_id                                          Int
  usuario_id                                            String    @db.Uuid
  estado_anterior_id                                    Int?
  estado_nuevo_id                                       Int
  comentario                                            String?
  fecha                                                 DateTime? @default(now()) @db.Timestamp(6)
  estado_historial_solicitud_estado_anterior_idToestado estado?   @relation("historial_solicitud_estado_anterior_idToestado", fields: [estado_anterior_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  estado_historial_solicitud_estado_nuevo_idToestado    estado    @relation("historial_solicitud_estado_nuevo_idToestado", fields: [estado_nuevo_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  solicitud                                             solicitud @relation(fields: [solicitud_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuario                                               usuario   @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([solicitud_id], map: "idx_historial_solicitud")
}

model menu {
  id           Int            @id @default(autoincrement())
  nombre       String         @db.VarChar(150)
  ruta         String?        @db.VarChar(200)
  orden        Int?           @default(0)
  activo       Boolean?       @default(true)
  icono        String?        @db.VarChar(50)
  key          String?        @db.VarChar(50)
  parent_id    Int?
  parent       menu?          @relation("menu_hierarchy", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children     menu[]         @relation("menu_hierarchy")
  rol_menu     rol_menu[]
  usuario_menu usuario_menu[]
}

model usuario_menu {
  id         Int      @id @default(autoincrement())
  usuario_id String   @db.Uuid
  menu_id    Int
  acciones   String[] @default([])
  usuario    usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  menu       menu     @relation(fields: [menu_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([usuario_id, menu_id])
}

model periodo {
  id           Int         @id @default(autoincrement())
  mes          Int
  anio         Int
  fecha_inicio DateTime    @db.Date
  fecha_fin    DateTime    @db.Date
  activo       Boolean?    @default(true)
  solicitud    solicitud[]

  @@unique([mes, anio])
}

model rol {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique @db.VarChar(100)
  descripcion String?
  activo      Boolean?   @default(true)
  created_at  DateTime?  @default(now()) @db.Timestamp(6)
  rol_menu    rol_menu[]
  usuario     usuario[]
}

model rol_menu {
  id              Int               @id @default(autoincrement())
  rol_id          Int
  menu_id         Int
  menu            menu              @relation(fields: [menu_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rol             rol               @relation(fields: [rol_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rol_menu_accion rol_menu_accion[]

  @@unique([rol_id, menu_id])
}

model rol_menu_accion {
  id          Int      @id @default(autoincrement())
  rol_menu_id Int
  accion_id   Int
  activo      Boolean? @default(true)
  accion      accion   @relation(fields: [accion_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rol_menu    rol_menu @relation(fields: [rol_menu_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([rol_menu_id, accion_id])
}

model solicitud {
  id                    Int                   @id @default(autoincrement())
  usuario_id            String                @db.Uuid
  estado_id             Int
  periodo_id            Int
  tipo_solicitud        String                @db.VarChar(100)
  es_extemporanea       Boolean?              @default(false)
  // Se capturó con permiso "Captura nueva solicitud": su vigencia puede pasar
  // de 6 meses (hasta el 31-dic). Se conserva para que editarla después no la rechace.
  vigencia_extendida    Boolean               @default(false)
  folio_recepcion       String?               @db.VarChar(50)
  folio_dictamen        String?               @db.VarChar(50)
  fecha_creacion        DateTime?             @default(now()) @db.Timestamp(6)
  fecha_envio           DateTime?             @db.Timestamp(6)
  fecha_emision         DateTime?             @db.Timestamp(6)
  folio_justificacion   String?               @db.VarChar(50)
  secretaria            String?               @db.VarChar(200)
  unidad_administrativa String?               @db.VarChar(200)
  unidad_responsable    String?               @db.VarChar(200)
  programa_proyecto     String?
  regimen               String?               @db.VarChar(100)
  tipo_actividades      String?               @db.VarChar(200)
  numero_prestadores    Int?
  denominacion          String?               @db.VarChar(200)
  vigencia_inicio       DateTime?             @db.Date
  vigencia_fin          DateTime?             @db.Date
  importe_bruto         Decimal?              @db.Decimal(14, 2)
  es_renovacion         Boolean?              @default(false)
  folio_anterior        String?               @db.VarChar(50)
  nivel_tabulador       String?               @db.VarChar(20)
  categoria_tabulador   String?               @db.VarChar(10)
  objeto                String?
  actividades                String[]              @default([])
  responsabilidades          String[]              @default([])
  marco_normativo            String[]              @default([])
  riesgo_caidas              String?               @db.VarChar(20)
  riesgo_mutilaciones        String?               @db.VarChar(20)
  riesgo_golpes              String?               @db.VarChar(20)
  riesgo_otros               String?               @db.VarChar(20)
  condicion_cambio_domicilio Boolean?              @default(false)
  condicion_horario          Boolean?              @default(false)
  condicion_viajar           Boolean?              @default(false)
  resguardo_activos          String?               @db.VarChar(10)
  escolaridad                String?
  comp_adm              String?
  comp_tec              String?
  comp_soc              String?
  valores               String?
  areas_exp             String?
  revisor_asignado_id   String?               @db.Uuid
  puesto_jefe_inmediato String?               @db.VarChar(200)
  condiciones_riesgos   String[]              @default([])
  tipo_importe             String?               @db.VarChar(20)
  modalidad_firma          String?               @db.VarChar(20)
  tipo_administracion      String?               @db.VarChar(20)
  secretaria_id_snapshot   String?               @db.Uuid
  secretaria_txt_snapshot  String?               @db.VarChar(512)
  adjunto                  adjunto[]
  catalogo_justificacion   catalogo_justificacion?
  checklist_detalle     checklist_detalle[]
  dictamen              dictamen?
  documento_sellado     documento_sellado[]
  firma_proceso         firma_proceso?
  historial_solicitud   historial_solicitud[]
  estado                estado                @relation(fields: [estado_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  periodo               periodo               @relation(fields: [periodo_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  revisor_asignado      usuario?              @relation("solicitud_revisor_asignado", fields: [revisor_asignado_id], references: [id], onUpdate: NoAction)
  usuario               usuario               @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([estado_id], map: "idx_solicitud_estado")
  @@index([usuario_id], map: "idx_solicitud_usuario")
}



model documento_sellado {
  id              Int       @id @default(autoincrement())
  solicitud_id    Int
  etapa           String    @db.VarChar(20)
  archivo         String    @db.VarChar(500)
  nombre_original String?   @db.VarChar(255)
  uploaded_by     String?   @db.Uuid
  uploaded_at     DateTime  @default(now()) @db.Timestamp(6)
  solicitud       solicitud @relation(fields: [solicitud_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  uploader        usuario?  @relation("documento_sellado_uploader", fields: [uploaded_by], references: [id], onUpdate: NoAction)

  @@unique([solicitud_id, etapa])
  @@index([solicitud_id], map: "idx_documento_sellado_solicitud")
}

model usuario {
  id                    String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nombre                String                @db.VarChar(150)
  correo                String                @unique @db.VarChar(150)
  password_hash         String
  rol_id                Int
  area_id               Int?
  activo                Boolean?              @default(true)
  fecha_creacion        DateTime?             @default(now()) @db.Timestamp(6)
  rfc                   String?               @unique @db.VarChar(13)
  must_change_password  Boolean?              @default(false)
  secretaria_id         String?               @db.Uuid
  secretaria_texto      String?               @db.VarChar(512)
  cargo                 String?               @db.VarChar(200)
  // Bloqueo por intentos fallidos de login (ver POST /api/auth?action=login):
  // intentos_fallidos cuenta consecutivos desde el último bloqueo/login
  // exitoso; nivel_bloqueo escala el umbral/duración del siguiente bloqueo
  // (0 = aún no se ha bloqueado nunca, 1+ = ya escaló al menos una vez).
  intentos_fallidos     Int                   @default(0)
  bloqueado_hasta       DateTime?             @db.Timestamp(6)
  nivel_bloqueo         Int                   @default(0)
  // Cierre de sesión por inactividad (backstop en servidor, ver
  // lib/validar-sesion.ts): se actualiza en login y en cada heartbeat que
  // manda el cliente mientras hay actividad real (lib/auth-context.tsx). Si
  // pasa más de 1h sin refrescarse, checkSesionUsuario rechaza la sesión
  // aunque el navegador nunca haya llamado a logout().
  ultima_actividad      DateTime?             @default(now()) @db.Timestamp(6)
  codigo_recuperacion    codigo_recuperacion?
  sesiones               sesion[]
  catalogo_solicitudes   catalogo_solicitud[]
  documentos_sellados    documento_sellado[]   @relation("documento_sellado_uploader")
  firma_proceso          firma_proceso[]
  firma_firmante         firma_firmante[]
  historial_solicitud    historial_solicitud[]
  permiso_captura        permiso_captura[]
  solicitudes_asignadas  solicitud[]           @relation("solicitud_revisor_asignado")
  solicitud              solicitud[]
  usuario_menu           usuario_menu[]
  area                  area?                 @relation(fields: [area_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rol                   rol                   @relation(fields: [rol_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organo_centralizado   organo_centralizado?  @relation(fields: [secretaria_id], references: [id], onUpdate: NoAction)

  @@index([rol_id], map: "idx_usuario_rol")
  @@index([rfc], map: "idx_usuario_rfc")
}

model codigo_recuperacion {
  id         Int       @id @default(autoincrement())
  usuario_id String    @unique @db.Uuid
  codigo     String    @db.VarChar(6)
  expira_en  DateTime  @db.Timestamp(6)
  usado      Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  intentos         Int     @default(0)
  reset_token_hash String? @db.VarChar(64)
  usuario    usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

// Sesión del lado del servidor (ver lib/session.ts). Solo se guarda el hash
// SHA-256 del token; el token en claro vive únicamente en la cookie HttpOnly.
model sesion {
  id         Int      @id @default(autoincrement())
  usuario_id String   @db.Uuid
  token_hash String   @unique @db.VarChar(64)
  creada_en  DateTime @default(now()) @db.Timestamp(6)
  expira_en  DateTime @db.Timestamp(6)
  usuario    usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([usuario_id], map: "idx_sesion_usuario")
}

model historico {
  id              String   @id(map: "PK_0fad738d5b2a11ac448686db608") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nombre_archivo  String   @db.VarChar(512)
  subido_en       DateTime @default(now()) @db.Timestamp(6)
  sheet_names     String[] @default([])
  sheets          Json     @default("{}")
  nombre_archivo2 String?  @db.VarChar(512)
  sheet_names2    String[] @default([])
  sheets2         Json?    @default("{}")
}

model calendario {
  id           Int     @id @default(autoincrement())
  ejercicio    Int
  limite_dgrh  String  @db.VarChar(20)
  limite_do    String  @db.VarChar(20)
  periodo      String  @db.VarChar(50)
  regimen      String  @db.VarChar(20)
  fecha_inicio String? @db.VarChar(20)
  fecha_fin    String? @db.VarChar(20)

  @@unique([ejercicio, regimen, periodo])
}

// Textos editables compartidos entre plantillas de PDF (p. ej. la nota al
// pie del Dictamen Técnico Funcional y de la Justificación de Prestación de
// Servicios): un solo registro por `clave`, editado desde la UI, leído por
// todas las rutas de generación de PDF que lo usan.
model configuracion_texto {
  id             Int      @id @default(autoincrement())
  clave          String   @unique @db.VarChar(50)
  valor          String
  actualizado_en DateTime @default(now()) @updatedAt
}

model organo_centralizado {
  id                      String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nombre                  String                @db.VarChar(512)
  orden                   Int                   @default(0)
  tipo                    String?               @db.VarChar(64)
  parent_id               String?               @db.Uuid
  clave_reporte_plazas    String?               @db.VarChar(100)
  ua_clave_administrativa String?               @db.VarChar(512)
  // idDependencia de SIGeF para esta Secretaría/Dependencia (solo en el nodo
  // raíz, parent_id = null). Con este dato, "Programa o Proyecto" en Nueva
  // Solicitud consulta las unidades de esa dependencia en SIGeF y une los
  // proyectos de todas ellas (cada unidad trae proyectos distintos).
  sigef_id_dependencia    Int?
  // Nombre y código (codigoDependencia) que SIGeF tenía en la última
  // sincronización (lib/sigef-sync.ts). Sirven para seguir reconociendo la
  // Secretaría si SIGeF le cambia el id o el nombre.
  sigef_nombre            String?               @db.VarChar(512)
  sigef_codigo            String?               @db.VarChar(10)
  parent                  organo_centralizado?  @relation("organo_centralizado_hierarchy", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  children                organo_centralizado[] @relation("organo_centralizado_hierarchy")
  usuarios                usuario[]
}

model categoria_paraestatal {
  id      Int                  @id @default(autoincrement())
  nombre  String               @db.VarChar(255)
  orden   Int                  @default(0)
  organos organo_paraestatal[]
}

model organo_paraestatal {
  id                      Int                   @id @default(autoincrement())
  nombre                  String                @db.VarChar(512)
  orden                   Int                   @default(0)
  categoria_id            Int
  clave_reporte_plazas    String?               @db.VarChar(100)
  ua_clave_administrativa String?               @db.VarChar(512)
  categoria               categoria_paraestatal @relation(fields: [categoria_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model catalogo_justificacion {
  id                        Int                  @id @default(autoincrement())
  solicitud_id              Int?                 @unique
  regimen_contratacion      String               @db.VarChar(50)
  programa_proyecto         String               @db.VarChar(500)
  tipo_actividad            String?              @db.VarChar(200)
  denominacion_nombramiento String?              @db.VarChar(300)
  puesto_jefe_inmediato     String?              @db.VarChar(200)
  numero_personas           Int?
  tipo_pago                 String?              @db.VarChar(50)
  importe_bruto             Decimal?             @db.Decimal(14, 2)
  importe_neto              Decimal?             @db.Decimal(14, 2)
  vigencia                  String?              @db.VarChar(200)
  archivo_pdf_sin_firmas    String?              @db.VarChar(500)
  activo                    Boolean              @default(true)
  creado_en                 DateTime             @default(now()) @db.Timestamp(6)
  actualizado_en            DateTime             @updatedAt @db.Timestamp(6)
  tipo_solicitud            String?              @db.VarChar(100)
  secretaria                String?              @db.VarChar(200)
  secretaria_txt_snapshot   String?              @db.VarChar(512)
  folio_recepcion           String?              @db.VarChar(50)
  folio_dictamen            String?              @db.VarChar(50)
  folio_justificacion       String?              @db.VarChar(50)
  folio_anterior            String?              @db.VarChar(50)
  objeto                    String?
  actividades               String[]             @default([])
  responsabilidades         String[]             @default([])
  escolaridad               String?
  comp_adm                  String?
  comp_tec                  String?
  comp_soc                  String?
  valores                   String?
  areas_exp                 String?
  unidad_administrativa     String?              @db.VarChar(200)
  unidad_responsable        String?              @db.VarChar(200)
  vigencia_inicio           DateTime?            @db.Date
  vigencia_fin              DateTime?            @db.Date
  es_renovacion             Boolean?             @default(false)
  tipo_administracion       String?              @db.VarChar(20)
  fecha_emision             DateTime?            @db.Timestamp(6)
  // "excel" = vino de la importación del histórico consolidado; "sistema" = dictamen emitido en el flujo normal.
  origen                    String               @default("sistema") @db.VarChar(20)
  solicitud                 solicitud?           @relation(fields: [solicitud_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  catalogo_solicitudes      catalogo_solicitud[]
}

model catalogo_solicitud {
  id                         Int                    @id @default(autoincrement())
  catalogo_justificacion_id  Int
  usuario_id                 String                 @db.Uuid
  nueva_vigencia             String                 @db.VarChar(200)
  nuevo_numero_personas      Int?
  nuevos_numero_prestadores  Int?
  nuevo_importe_bruto        Decimal?               @db.Decimal(14, 2)
  tipo                       String                 @default("reutilizacion") @db.VarChar(20)
  // Solo para tipo = "programa": trazabilidad del cambio de Programa/Proyecto.
  programa_anterior          String?                @db.VarChar(500)
  nuevo_programa_proyecto    String?                @db.VarChar(500)
  archivo_pdf_generado       String?                @db.VarChar(500)
  procesado                  Boolean                @default(false)
  procesado_en               DateTime?              @db.Timestamp(6)
  solicitud_nueva_id         Int?
  // "Folio actual" del dictamen de esta reutilización/cancelación:
  // NN/MM/AAAA-CH (Honorarios) o -CA (Asimilados), consecutivo global que se
  // reinicia cada mes (ver lib/folio-catalogo.ts). null en las filas creadas
  // antes de este formato: esas siguen mostrando "folio de origen-N".
  folio                      String?                @unique @db.VarChar(50)
  folio_consecutivo          Int?
  folio_mes                  Int?
  folio_anio                 Int?
  folio_tipo                 String?                @db.VarChar(2)
  creado_en                  DateTime               @default(now()) @db.Timestamp(6)
  catalogo_justificacion     catalogo_justificacion @relation(fields: [catalogo_justificacion_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuario                    usuario                @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // CH y CA comparten contador: un consecutivo no se repite en el mismo mes/año.
  @@unique([folio_anio, folio_mes, folio_consecutivo])
}

model permiso_captura {
  id          Int       @id @default(autoincrement())
  usuario_id  String    @db.Uuid
  regimen     String    @db.VarChar(20)
  periodo     String    @db.VarChar(50)
  active      Boolean   @default(true)
  used        Boolean   @default(false)
  granted_at  DateTime  @default(now()) @db.Timestamp(6)
  granted_by  String    @db.VarChar(150)
  consumed_at DateTime? @db.Timestamp(6)
  usuario     usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

// Tabulador de niveles/categorías usado por "Equivalencia al Tabulador" en el
// formulario de Nueva Solicitud (antes vivía hardcodeado en lib/tabulador.ts).
model tabulador {
  id                Int      @id @default(autoincrement())
  // Año del tabulador. Un año nuevo solo se crea (plantilla) si ese año ya
  // tiene Calendario. Nueva solicitud valida contra el del año en curso.
  ejercicio         Int
  nivel             String   @db.VarChar(20)
  categoria         String   @db.VarChar(50)
  importe_bruto_min Decimal  @db.Decimal(14, 2)
  importe_bruto_max Decimal  @db.Decimal(14, 2)
  // [] = aplica a todas las Secretarías/Dependencias. No vacío = solo a las
  // nombradas ahí (nombre tal cual en organo_centralizado).
  secretarias       String[] @default([])
  creado_en         DateTime @default(now()) @db.Timestamp(6)
  actualizado_en    DateTime @default(now()) @updatedAt @db.Timestamp(6)

  @@index([ejercicio])
}

// Tipos de pago del combo "Tipo de Pago" en Nueva Solicitud (antes fijos en el
// código), administrados en Configuración > Tipos de pago. `clave` es lo que se
// guarda en solicitud.tipo_importe (VarChar(20)) y no cambia una vez creada.
// Eliminar solo desactiva (`activo = false`): las solicitudes que ya usan la
// clave la siguen mostrando.
model tipo_pago {
  id             Int      @id @default(autoincrement())
  clave          String   @unique @db.VarChar(20)
  nombre         String   @db.VarChar(20)
  // false = no aplica "Equivalencia al Tabulador" (se bloquea y no se exige).
  usa_tabulador  Boolean  @default(true)
  orden          Int      @default(0)
  activo         Boolean  @default(true)
  creado_en      DateTime @default(now()) @db.Timestamp(6)
  actualizado_en DateTime @default(now()) @updatedAt @db.Timestamp(6)
}
