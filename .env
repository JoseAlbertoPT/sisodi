# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# The following `prisma+postgres` URL is similar to the URL produced by running a local Prisma Postgres
# server with the `prisma dev` CLI command, when not choosing any non-default ports or settings. The API key, unlike the
# one found in a remote Prisma Postgres URL, does not contain any sensitive information.

DATABASE_URL="postgresql://charlesdays:@localhost:5432/sisodij"
NEXT_PUBLIC_API_URL=http://localhost:3001/api
#NEXT_PUBLIC_API_URL=http://192.168.114.148:3001/api

# Portal de firmado e.firma (proyecto api-Efirma/efirma-portal)
EFIRMA_PORTAL_URL=http://localhost:3001
EFIRMA_PROJECT_TOKEN=pk_e8caf65eb91f37dee81d7b62b94bf67b

# URL pública de esta app (para generar links de firmado externo)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ========================================================                                                                                                
# Bypass de firma electronica (SOLO DESARROLLO / QA)                                                                                                      
# true  -> no llama al portal efirma, simula firma exitosa                                                                                                
#          y permite que un mismo usuario firme todos los                                                                                                 
#          slots internos (ideal para pruebas del flujo).                                                                                                 
# false -> comportamiento normal de produccion.                                                                                                           
# No dejar en true en produccion.                                                                                                                         
# ========================================================  
EFIRMA_BYPASS=true 