# URL base del API (backend). Incluir /api si el servidor usa prefijo global "api".
# Ejemplo: si el backend corre en http://localhost:3000 con prefijo "api", usar:
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Web Service SOAP de firma electrónica WSFirmaOficio (firma-dev.morelos.gob.mx),
# operación firmaDatosEx. Documentación: https://tecnologia.morelos.gob.mx/d/6f552849/untitled-document
FIRMA_OFICIO_WS_URL=https://firma-dev.morelos.gob.mx/WSFirmaOficio
FIRMA_OFICIO_TOKEN=
# tipoDocumento fijo para Justificación/Dictamen (proporcionado por el proveedor)
FIRMA_OFICIO_TIPO_DOCUMENTO=32

# Bypass de firma electronica (SOLO DESARROLLO / QA) — true simula firma exitosa
# sin llamar a WSFirmaOficio. No dejar en true en producción.
EFIRMA_BYPASS=false

# URL pública de esta app (para generar links de firmado externo)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web Service SOAP de SIGeF (ControlProyectosServicio) — consulta de
# "Programa o Proyecto" en Nueva Solicitud.
SIGEF_WS_URL=https://sigef2026.morelos.gob.mx/wsproyectos/services/ControlProyectosServicio
SIGEF_APP_ID=
# Timeout del fetch al WS de SIGeF, en ms (opcional, default 10000)
SIGEF_TIMEOUT_MS=10000

# Almacenamiento de archivos (adjuntos, documentos sellados, firma autógrafa)
# en S3 / S3-compatible (dev-s3.morelos.gob.mx). Bucket privado — la descarga
# se sirve siempre a través de las rutas proxy del propio backend, nunca por
# URL directa. Credenciales reales: gestor de contraseñas, entrada "S3 <proyecto> dev".
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
