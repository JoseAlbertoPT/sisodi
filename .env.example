# URL base del API (backend). Incluir /api si el servidor usa prefijo global "api".
# Ejemplo: si el backend corre en http://localhost:3000 con prefijo "api", usar:
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Portal de firmado e.firma (proyecto api-Efirma/efirma-portal)
EFIRMA_PORTAL_URL=http://localhost:3001
EFIRMA_PROJECT_TOKEN=pk_xxxxxxxxxxxxxxxxxxxx

# URL pública de esta app (para generar links de firmado externo)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web Service SOAP de SIGeF (ControlProyectosServicio) — consulta de
# "Programa o Proyecto" en Nueva Solicitud.
SIGEF_WS_URL=https://sigef2026.morelos.gob.mx/wsproyectos/services/ControlProyectosServicio
SIGEF_APP_ID=
# Timeout del fetch al WS de SIGeF, en ms (opcional, default 10000)
SIGEF_TIMEOUT_MS=10000
